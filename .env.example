# Optionnel : URL d'un service de formulaire (Formspree, Getform, Basin…).
# Sans cette variable, l'envoi est simulé côté client.
NEXT_PUBLIC_FORM_ENDPOINT=
# URL publique du site (sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://atelier404.fr
# Sous-chemin de déploiement, si le site ne vit pas à la racine du domaine
# (ex. https://mondomaine.fr/atelier404 → NEXT_PUBLIC_BASE_PATH=/atelier404).
# Vide par défaut. Doit être défini AU BUILD (figé dans les fichiers générés) :
#   NEXT_PUBLIC_BASE_PATH=/atelier404 NEXT_PUBLIC_SITE_URL=https://mondomaine.fr npm run build
NEXT_PUBLIC_BASE_PATH=
